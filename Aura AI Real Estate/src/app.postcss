@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
    --theme-font-family-base: 'Inter', sans-serif;
    --theme-font-family-heading: 'Playfair Display', serif;
}

body {
    @apply bg-lux-background text-lux-textPrimary font-body overflow-x-hidden;
}

h1, h2, h3, h4, h5, h6 {
    @apply font-heading;
}

/* Custom Scrollbar for Luxury Feel */
::-webkit-scrollbar {
    width: 6px;
}
::-webkit-scrollbar-track {
    background: #0B1120; 
}
::-webkit-scrollbar-thumb {
    background: #1E2A47; 
    border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
    background: #C6A96B; 
}
